{
  "uid": "buildkite-infra",
  "title": "Buildkite infrastructure",
  "description": "agent-stack-k8s controller health, and queue wait from Buildkite's OpenTelemetry integration.",
  "tags": [
    "buildkite",
    "otel"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_metrics",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/-prom$/",
        "hide": 0,
        "refresh": 1,
        "current": {}
      },
      {
        "name": "ds_traces",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "regex": "/-traces$/",
        "hide": 0,
        "refresh": 1,
        "current": {}
      }
    ]
  },
  "links": [
    {
      "title": "Buildkite dashboards",
      "type": "dashboards",
      "tags": [
        "buildkite"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "agent-stack-k8s controller",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Jobs running now",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum(buildkite_deduper_jobs_running)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Max in flight",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "max(buildkite_limiter_max_in_flight)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Jobs created in range",
      "description": "Kubernetes Jobs the controller created.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "round(sum(increase(buildkite_scheduler_job_create_success_total[$__range])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Controller up",
      "description": "1 when Alloy (k8s-monitoring) can scrape the controller.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "max(up{job=\"buildkite/agent-stack-k8s\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Jobs in flight",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum(buildkite_deduper_jobs_running)",
          "legendFormat": "running",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "max(buildkite_limiter_max_in_flight)",
          "legendFormat": "max in flight",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum(buildkite_limiter_tokens_available)",
          "legendFormat": "tokens available",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Time to create a Kubernetes Job (p50 / p95)",
      "description": "From the controller's query returning the job to the Kubernetes Job being created.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(buildkite_job_end_to_end_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(buildkite_job_end_to_end_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Controller problems",
      "description": "Jobs the controller had to fail or clean up. Should stay at zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum(increase(buildkite_job_watcher_jobs_stalled_without_pod_total[$__rate_interval]))",
          "legendFormat": "stalled without pod",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum(increase(buildkite_job_watcher_jobs_failed_before_agent_acquire_total[$__rate_interval]))",
          "legendFormat": "pod failed before agent started",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum(increase(buildkite_scheduler_jobs_failed_on_buildkite_total[$__rate_interval]))",
          "legendFormat": "failed by scheduler",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum(increase(buildkite_pod_watcher_jobs_failed_on_buildkite_total[$__rate_interval]))",
          "legendFormat": "failed by pod watcher",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Buildkite API query time (p95)",
      "description": "How long the controller's poll for queued jobs takes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(buildkite_monitor_job_query_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Agent pings and log uploads",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum(rate(buildkite_agent_pings_sent_total[$__rate_interval]))",
          "legendFormat": "pings/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum(rate(buildkite_agent_pings_errors_total[$__rate_interval]))",
          "legendFormat": "ping errors/s",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum(rate(buildkite_agent_logs_chunk_uploads_errored_total[$__rate_interval]))",
          "legendFormat": "log upload errors/s",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "id": 10
    },
    {
      "type": "row",
      "title": "Queue wait (Buildkite OpenTelemetry integration)",
      "id": 11,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "p95 queue wait by queue",
      "description": "How long jobs wait for an agent, per queue. A rising line on kube with jobs in flight at max-in-flight means the controller is the bottleneck. Empty until the integration is on.",
      "datasource": {
        "type": "tempo",
        "uid": "${ds_traces}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${ds_traces}"
          },
          "refId": "A",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{ name = \"buildkite.job\" } | quantile_over_time(span.buildkite.job.wait_time_ms, .95) by (span.buildkite.agent.queue)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "points",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 6,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*span\\.buildkite\\.agent\\.queue=\"([^\"]+)\".*",
            "renamePattern": "$1"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Jobs started by queue",
      "description": "Job attempts per queue, from Buildkite's side.",
      "datasource": {
        "type": "tempo",
        "uid": "${ds_traces}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${ds_traces}"
          },
          "refId": "A",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{ name = \"buildkite.job\" } | count_over_time() by (span.buildkite.agent.queue)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*span\\.buildkite\\.agent\\.queue=\"([^\"]+)\".*",
            "renamePattern": "$1"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "id": 13
    }
  ]
}