{
  "queues": {
    "kubernetes": {
      "key": "kube",
      "type": "self_hosted",
      "environment_override": "BUILDKITE_QUEUE_KUBERNETES",
      "description": "Self-hosted Kubernetes agents used by the NASA application."
    },
    "macos-medium": {
      "key": "macos-med",
      "type": "hosted",
      "environment_override": "BUILDKITE_QUEUE_MACOS_MEDIUM",
      "description": "Buildkite hosted macOS medium agents."
    },
    "macos-large": {
      "key": "macos-lg",
      "type": "hosted",
      "environment_override": "BUILDKITE_QUEUE_MACOS_LARGE",
      "description": "Buildkite hosted macOS large agents."
    }
  },
  "pipelines": {
    "ao-tests": {
      "queue": "kube"
    },
    "ao-deploy": {
      "queue": "kube"
    }
  },
  "workloads": {
    "record-cluster": {
      "queue": "kube"
    },
    "unit": {
      "queue": "default"
    },
    "integration": {
      "queue": "kube"
    },
    "e2e": {
      "queue": "macos-medium"
    },
    "summary": {
      "queue": "kube"
    }
  }
}
