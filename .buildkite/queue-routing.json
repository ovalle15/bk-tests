{
  "queues": {
    "linux-sm-hosted": {
      "key": "linux-sm",
      "type": "hosted",
      "environment_override": "BUILDKITE_QUEUE_LINUX_HOSTED"
    },
    "kubernetes": {
      "key": "kube",
      "type": "self_hosted",
      "environment_override": "BUILDKITE_QUEUE_KUBERNETES",
      "description": "Self-hosted Kubernetes jobs run by agent-stack-k8s, traced with otel"
    },
    "macos-medium": {
      "key": "macos-med",
      "type": "hosted",
      "environment_override": "BUILDKITE_QUEUE_MACOS_MEDIUM",
      "description": "Buildkite hosted macOS medium agents."
    },
    "macos-large": {
      "key": "macos-lg",
      "type": "hosted",
      "environment_override": "BUILDKITE_QUEUE_MACOS_LARGE",
      "description": "Buildkite hosted macOS large agents."
    },
    "default": {
      "key": "default",
      "type": "self_hosted",
      "environment_override": "BUILDKITE_QUEUE_DEFAULT",
      "description": "The test cluster's default queue."
    },
    "mac-cache": {
      "key": "cache",
      "type": "self_hosted",
      "environment_override": "BUILDKITE_QUEUE_MAC_CACHE",
      "description": "Self-hosted Buildkite agent on Andrea's Mac, for the ao-cache pipeline."
    }
  },
  "pipelines": {
    "ao-tests": {
      "queue": "kubernetes"
    },
    "ao-deploy": {
      "queue": "kubernetes"
    },
    "ao-cache": {
      "queue": "mac-cache"
    }
  },
  "workloads": {
    "record-cluster": {
      "queue": "kubernetes"
    },
    "unit": {
      "queue": "kubernetes"
    },
    "integration": {
      "queue": "kubernetes"
    },
    "e2e": {
      "queue": "kubernetes"
    },
    "summary": {
      "queue": "kubernetes"
    }
  }
}
