{
  "uid": "buildkite-traces",
  "title": "Buildkite traces",
  "description": "Explore Buildkite build traces (OpenTelemetry integration) and job traces (agent) in Tempo.",
  "tags": [
    "buildkite",
    "otel"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_traces",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "regex": "/-traces$/",
        "hide": 0,
        "refresh": 1,
        "current": {}
      },
      {
        "name": "pipeline",
        "label": "Pipeline",
        "type": "query",
        "datasource": {
          "type": "tempo",
          "uid": "${ds_traces}"
        },
        "query": {
          "label": "buildkite.pipeline.slug",
          "type": 1,
          "refId": "pipeline"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "title": "Buildkite dashboards",
      "type": "dashboards",
      "tags": [
        "buildkite"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "Two kinds of traces. **Builds** (top section) come from Buildkite's OpenTelemetry integration: one trace per build (`buildkite.build` \u2192 steps \u2192 `buildkite.job`) for every pipeline and queue, empty until the integration is on. **Jobs on kube** (below) come from the agent in each job pod: two traces per job, one for the checkout container and one for the command container, sharing `buildkite.job_id`. Click a trace ID to open it; from an agent span, **Logs for this span** opens its job output."
      },
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "row",
      "title": "Builds (Buildkite OpenTelemetry integration)",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Builds by pipeline",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "${ds_traces}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${ds_traces}"
          },
          "refId": "A",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{ name = \"buildkite.build\" && resource.buildkite.pipeline.slug =~ \"${pipeline:regex}\" } | count_over_time() by (resource.buildkite.pipeline.slug)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*resource\\.buildkite\\.pipeline\\.slug=\"([^\"]+)\".*",
            "renamePattern": "$1"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Failed builds by pipeline",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "${ds_traces}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${ds_traces}"
          },
          "refId": "A",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{ name = \"buildkite.build\" && span.buildkite.build.state = \"failed\" && resource.buildkite.pipeline.slug =~ \"${pipeline:regex}\" } | count_over_time() by (resource.buildkite.pipeline.slug)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*resource\\.buildkite\\.pipeline\\.slug=\"([^\"]+)\".*",
            "renamePattern": "$1"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "p95 build duration by pipeline",
