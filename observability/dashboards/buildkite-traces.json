        "x": 0,
        "y": 12
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "p95 queue wait by step",
      "description": "How long each step's jobs waited for an agent (`buildkite.job.wait_time_ms`).",
      "datasource": {
        "type": "tempo",
        "uid": "${ds_traces}"
