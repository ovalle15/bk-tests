      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Total time in agent CLI calls",
      "description": "Time your scripts spend in buildkite-agent subcommands.",
      "datasource": {
        "type": "tempo",
        "uid": "${ds_traces}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${ds_traces}"
          },
          "refId": "A",
          "queryType": "traceql",
          "metricsQueryType": "instant",
