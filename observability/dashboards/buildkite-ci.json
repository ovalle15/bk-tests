    {
      "type": "bargauge",
      "title": "Average time per CLI call",
      "description": "Average duration of a single call.",
      "datasource": {
        "type": "tempo",
        "uid": "${ds_traces}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${ds_traces}"
          },
          "refId": "A",
          "queryType": "traceql",
          "metricsQueryType": "instant",
          "query": "{ name =~ \"pipeline-upload|annotate|meta-data-.*|artifact-upload|artifacts|artifact-download\" && resource.buildkite.pipeline =~ \"${pipeline:regex}\" } | avg_over_time(duration) by (name)"
        }
