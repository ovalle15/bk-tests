      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=\"buildkite-agent\"} | buildkite_pipeline_slug=~\"${pipeline:regex}\" |~ \"(?i)(error|failed|not found|denied|exit status [1-9])\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
