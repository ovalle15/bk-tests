    {
      "type": "row",
      "title": "Failures",
      "id": 17,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Recent failed traces",
      "description": "Click a trace ID to open it, then use 'Logs for this span'.",
      "datasource": {
        "type": "tempo",
        "uid": "${ds_traces}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${ds_traces}"
          },
          "refId": "A",
          "queryType": "traceql",
          "tableType": "traces",
          "limit": 20,
          "query": "{ status = error && resource.buildkite.pipeline =~ \"${pipeline:regex}\" }"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "id": 18
    },
    {
      "type": "logs",
      "title": "Error lines in job logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${ds_logs}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_logs}"
          },
          "refId": "A",
          "expr": "{service_name=\"buildkite-agent\"} | buildkite_pipeline_slug=~\"${pipeline:regex}\" |~ \"(?i)(error|failed|not found|denied|exit status [1-9])\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
